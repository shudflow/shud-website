---
import content from '../content.json';
import '../styles/global.css';

const { meta, nav, hero, status, team, links, footer } = content;
const stateLabel = { done: 'Done', progress: 'In progress', planned: 'Planned' } as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={meta.url} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={meta.url} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="page">
      <header class="top">
        <a class="brand" href="#top" aria-label="Shudflow">
          <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="7" fill="#0d0f14"/><path d="M8 9l7 7-7 7M16 9l7 7-7 7" fill="none" stroke="#6ea0ff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Shudflow</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} {...(n.external ? { rel: 'noopener noreferrer' } : {})}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
        <button id="theme-toggle" class="toggle" type="button" aria-label="Switch colour theme">
          <span aria-hidden="true">◐</span>
        </button>
      </header>

      <main id="main">
        <section class="hero" id="top">
          <h1>{hero.title}</h1>
          <p class="lead">{hero.subtitle}</p>
          <p class="context mono">{hero.context}</p>
          <ol class="flow mono" aria-label="How an answer is produced">
            {hero.flow.map((step) => <li>{step}</li>)}
          </ol>
        </section>

        <section id="status" aria-labelledby="h-status">
          <h2 id="h-status">Status <span class="mono muted">· {status.date}</span></h2>
          <ul class="rows">
            {status.items.map((it) => (
              <li>
                <span class={`badge mono ${it.state}`}>{stateLabel[it.state as keyof typeof stateLabel]}</span>
                <span class="row-body">
                  <strong>{it.title}</strong>
                  {it.text && <span class="muted"> {it.text}</span>}
                </span>
              </li>
            ))}
          </ul>
        </section>

        <section id="team" aria-labelledby="h-team">
          <h2 id="h-team">Team</h2>
          <ul class="rows plain">
            {team.items.map((p) => (
              <li><span class="row-body"><strong>{p.name}</strong> <span class="muted">{p.role}</span></span></li>
            ))}
          </ul>
        </section>

        <section id="links" aria-labelledby="h-links">
          <h2 id="h-links">Links</h2>
          <p class="muted note">{links.note}</p>
          <ul class="rows plain">
            {links.items.map((l) => (
              <li>
                <a class="arrow" href={l.href} rel="noopener noreferrer">
                  <span class="mono">{l.label}</span> <span aria-hidden="true">→</span>
                </a>
                {l.private && <span class="muted mono tag">private</span>}
              </li>
            ))}
          </ul>
          <p class="contact">Contact: <a href={links.contact.href}>{links.contact.label}</a></p>
        </section>
      </main>

      <footer>
        <p>{footer.access}</p>
        <p class="muted mono">{footer.company}</p>
      </footer>
    </div>

    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        var root = document.documentElement;
        btn.addEventListener('click', function () {
          var current = root.getAttribute('data-theme');
          if (!current) current = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          var next = current === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
